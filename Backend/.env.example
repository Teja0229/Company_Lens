# Existing Supabase project values (do not commit Backend/.env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Generic public company listing site. Update selectors for the target site.
LISTING_URL=https://example.com/companies
LISTING_CARD_SELECTOR=.company-card
COMPANY_NAME_SELECTOR=.company-name
COMPANY_TYPE_SELECTOR=.company-type
ADDRESS_SELECTOR=.company-address
WEBSITE_SELECTOR=a.company-website
VIEW_PROFILE_SELECTOR=a.view-profile
NEXT_PAGE_SELECTOR=a[rel='next'], button.next-page
LOAD_MORE_SELECTOR=button.load-more
EMAIL_SELECTOR=a[href^='mailto:']
LINKEDIN_SELECTOR=a[href*='linkedin.com/company']
RATING_SELECTOR=.rating, [data-rating]
MEMBER_SELECTOR=.member-card
MEMBER_NAME_SELECTOR=.member-name
MEMBER_ROLE_SELECTOR=.member-role
MEMBER_LINKEDIN_SELECTOR=a[href*='linkedin.com/in']
CAREERS_LINK_SELECTOR=a[href*='career'], a[href*='job']
JOB_SELECTOR=.job-card, article.job
JOB_ROLE_SELECTOR=.job-title, h2, h3
POSTED_DATE_SELECTOR=time, .posted-date
EXPERIENCE_SELECTOR=.experience
JOB_LOCATION_SELECTOR=.location
JOB_DESCRIPTION_SELECTOR=.description
APPLY_LINK_SELECTOR=a[href*='apply'], a.apply
SCRAPER_HEADLESS=true
